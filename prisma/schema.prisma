// FORCE SCHOOLS ERP - DATABASE SCHEMA
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  IT
  SECRETARY
  PRINCIPAL
  ACCOUNTANT
  TEACHER
  STUDENT
  PARENT
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  staff        Staff?
  student      Student?
  parentLinks  ParentLink[]
  auditLogs    AuditLog[]
  @@index([role])
}

model ParentLink {
  id        String   @id @default(cuid())
  parent    User     @relation(fields: [parentId], references: [id], onDelete: Cascade)
  parentId  String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId String
  relation  String
  createdAt DateTime @default(now())
  @@unique([parentId, studentId])
}

model Session {
  id        String   @id @default(cuid())
  name      String   @unique
  isCurrent Boolean  @default(false)
  terms     Term[]
  createdAt DateTime @default(now())
}

model Term {
  id          String   @id @default(cuid())
  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId   String
  name        String
  isCurrent   Boolean  @default(false)
  startDate   DateTime?
  endDate     DateTime?
  invoices    Invoice[]
  scores      Score[]
  attendances Attendance[]
  resultPins  ResultPin[]
  @@unique([sessionId, name])
}

model SchoolClass {
  id    String @id @default(cuid())
  name  String
  order Int    @default(0)
  arms  Arm[]
}

model Arm {
  id             String      @id @default(cuid())
  name           String
  schoolClass    SchoolClass @relation(fields: [schoolClassId], references: [id], onDelete: Cascade)
  schoolClassId  String
  classTeacher   Staff?      @relation(fields: [classTeacherId], references: [id])
  classTeacherId String?
  students       Student[]
  subjects       ArmSubject[]
  feeItems       FeeItem[]
  timetableSlots TimetableSlot[]
  @@unique([schoolClassId, name])
}

model Subject {
  id       String       @id @default(cuid())
  name     String       @unique
  code     String?      @unique
  armLinks ArmSubject[]
}

model ArmSubject {
  id             String          @id @default(cuid())
  arm            Arm             @relation(fields: [armId], references: [id], onDelete: Cascade)
  armId          String
  subject        Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subjectId      String
  teacher        Staff?          @relation(fields: [teacherId], references: [id])
  teacherId      String?
  scores         Score[]
  timetableSlots TimetableSlot[]
  @@unique([armId, subjectId])
}

model TimetableSlot {
  id           String     @id @default(cuid())
  arm          Arm        @relation(fields: [armId], references: [id], onDelete: Cascade)
  armId        String
  armSubject   ArmSubject @relation(fields: [armSubjectId], references: [id], onDelete: Cascade)
  armSubjectId String
  dayOfWeek    Int
  period       Int
  @@unique([armId, dayOfWeek, period])
}

model Staff {
  id             String         @id @default(cuid())
  staffId        String         @unique
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String         @unique
  firstName      String
  lastName       String
  category       String
  designation    String?
  qualification  String?
  phone          String?
  monthlySalary  Float?
  isActive       Boolean        @default(true)
  classesLed     Arm[]
  subjectsTaught ArmSubject[]
  payslips       Payslip[]
  leaveRequests  LeaveRequest[]
  createdAt      DateTime       @default(now())
}

model Student {
  id               String                @id @default(cuid())
  admissionNumber  String                @unique
  user             User?                 @relation(fields: [userId], references: [id])
  userId           String?               @unique
  firstName        String
  lastName         String
  otherNames       String?
  gender           String?
  dateOfBirth      DateTime?
  address          String?
  previousSchool   String?
  medicalNotes     String?
  status           String                @default("ACTIVE")
  arm              Arm?                  @relation(fields: [armId], references: [id])
  armId            String?
  scores           Score[]
  attendances      Attendance[]
  invoices         Invoice[]
  payments         Payment[]
  parentLinks      ParentLink[]
  documents        Document[]
  bookLoans        BookLoan[]
  hostelAllocs     HostelAllocation[]
  transportEnrolls TransportEnrollment[]
  cbtAttempts      CbtAttempt[]
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
}

model Document {
  id         String   @id @default(cuid())
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId  String
  label      String
  fileUrl    String
  uploadedAt DateTime @default(now())
}

model LeaveRequest {
  id        String   @id @default(cuid())
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  staffId   String
  startDate DateTime
  endDate   DateTime
  reason    String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
}

model LibraryBook {
  id        String     @id @default(cuid())
  title     String
  author    String?
  isbn      String?
  copies    Int        @default(1)
  available Int        @default(1)
  loans     BookLoan[]
  createdAt DateTime   @default(now())
}

model BookLoan {
  id         String      @id @default(cuid())
  book       LibraryBook @relation(fields: [bookId], references: [id], onDelete: Cascade)
  bookId     String
  student    Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId  String
  borrowedAt DateTime    @default(now())
  dueDate    DateTime?
  returnedAt DateTime?
}

model HostelRoom {
  id          String             @id @default(cuid())
  name        String
  block       String?
  capacity    Int                @default(4)
  gender      String?
  allocations HostelAllocation[]
  createdAt   DateTime           @default(now())
}

model HostelAllocation {
  id          String     @id @default(cuid())
  room        HostelRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomId      String
  student     Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId   String
  bedLabel    String?
  status      String     @default("ACTIVE")
  allocatedAt DateTime   @default(now())
  vacatedAt   DateTime?
}

model TransportRoute {
  id          String                @id @default(cuid())
  name        String
  vehicle     String?
  driverName  String?
  driverPhone String?
  feeAmount   Float                 @default(0)
  enrollments TransportEnrollment[]
  createdAt   DateTime              @default(now())
}

model TransportEnrollment {
  id        String         @id @default(cuid())
  route     TransportRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  routeId   String
  student   Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId String
  status    String         @default("ACTIVE")
  startDate DateTime       @default(now())
  endDate   DateTime?
}

model CmsPage {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  body      String
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteTheme {
  id         String   @id @default(cuid())
  configJson String
  updatedAt  DateTime @updatedAt
}

model CbtExam {
  id              String        @id @default(cuid())
  title           String
  durationMinutes Int           @default(30)
  armId           String?
  isOpen          Boolean       @default(false)
  negativeMark    Float         @default(0)
  proctoring      Boolean       @default(true)
  createdBy       String?
  questions       CbtQuestion[]
  attempts        CbtAttempt[]
  createdAt       DateTime      @default(now())
}

model CbtQuestion {
  id           String  @id @default(cuid())
  exam         CbtExam @relation(fields: [examId], references: [id], onDelete: Cascade)
  examId       String
  prompt       String
  type         String  @default("MCQ")
  optionsJson  String?
  correctIndex Int?
  marks        Float   @default(1)
  order        Int     @default(0)
  bankId       String?
}

model CbtBankQuestion {
  id           String   @id @default(cuid())
  prompt       String
  type         String   @default("MCQ")
  optionsJson  String?
  correctIndex Int?
  marks        Float    @default(1)
  subjectTag   String?
  createdAt    DateTime @default(now())
}

model CbtAttempt {
  id           String   @id @default(cuid())
  exam         CbtExam  @relation(fields: [examId], references: [id], onDelete: Cascade)
  examId       String
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId    String
  score        Float
  total        Float
  percent      Int
  answersJson  String
  proctorJson  String?
  needsGrading Boolean  @default(false)
  submittedAt  DateTime @default(now())
}

model ReportCardTemplate {
  id         String   @id @default(cuid())
  name       String
  configJson String
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())
}

model GradeBand {
  id       String @id @default(cuid())
  minScore Float
  maxScore Float
  grade    String
  remark   String
}

model Score {
  id           String     @id @default(cuid())
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId    String
  armSubject   ArmSubject @relation(fields: [armSubjectId], references: [id], onDelete: Cascade)
  armSubjectId String
  term         Term       @relation(fields: [termId], references: [id], onDelete: Cascade)
  termId       String
  ca1          Float      @default(0)
  ca2          Float      @default(0)
  exam         Float      @default(0)
  total        Float      @default(0)
  grade        String?
  remark       String?
  enteredBy    String?
  @@unique([studentId, armSubjectId, termId])
}

model Attendance {
  id        String   @id @default(cuid())
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId String
  term      Term     @relation(fields: [termId], references: [id], onDelete: Cascade)
  termId    String
  date      DateTime
  status    String
  @@unique([studentId, date])
}

model ResultPin {
  id        String    @id @default(cuid())
  code      String    @unique
  term      Term      @relation(fields: [termId], references: [id], onDelete: Cascade)
  termId    String
  isUsed    Boolean   @default(false)
  usedBy    String?
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model FeeItem {
  id         String   @id @default(cuid())
  arm        Arm      @relation(fields: [armId], references: [id], onDelete: Cascade)
  armId      String
  termId     String
  name       String
  amount     Float
  compulsory Boolean  @default(true)
  createdAt  DateTime @default(now())
}

model Invoice {
  id          String    @id @default(cuid())
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId   String
  term        Term      @relation(fields: [termId], references: [id], onDelete: Cascade)
  termId      String
  lineItems   String
  totalAmount Float
  amountPaid  Float     @default(0)
  status      String    @default("UNPAID")
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  payments    Payment[]
  @@index([studentId])
  @@index([status])
}

model Payment {
  id         String   @id @default(cuid())
  invoice    Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId  String
  amount     Float
  method     String
  reference  String   @unique
  status     String   @default("SUCCESS")
  paidAt     DateTime @default(now())
  recordedBy String?
}

model ExpenseRecord {
  id          String   @id @default(cuid())
  category    String
  description String
  amount      Float
  date        DateTime @default(now())
  recordedBy  String?
}

model Payslip {
  id          String   @id @default(cuid())
  staff       Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  staffId     String
  month       String
  gross       Float
  deductions  Float    @default(0)
  net         Float
  generatedAt DateTime @default(now())
  @@unique([staffId, month])
}

model Notice {
  id           String   @id @default(cuid())
  title        String
  body         String
  audience     String   @default("ALL")
  publishToWeb Boolean  @default(false)
  createdBy    String?
  createdAt    DateTime @default(now())
}

model MessageLog {
  id        String   @id @default(cuid())
  channel   String
  recipient String
  body      String
  status    String   @default("QUEUED")
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?
  action    String
  entity    String
  entityId  String?
  details   String?
  createdAt DateTime @default(now())
  @@index([entity, entityId])
}
