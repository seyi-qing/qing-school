# Copy to .env locally. On Vercel: Project → Settings → Environment Variables.

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"
SESSION_SECRET="change-this-to-a-long-random-string-at-least-32-chars"
SETUP_SECRET="one-time-seed-secret-for-phone-setup"

# Production bootstrap only — set true briefly, then REMOVE
# ALLOW_PRODUCTION_SETUP="true"
# ALLOW_SETUP_SEED="false"  # after bootstrap, keep disabled

# Public site URL (Paystack callback)
NEXT_PUBLIC_APP_URL=""

# Payments
# PAYMENTS_MODE=mock  until keys are ready (webhook accepts unsigned only in mock)
# PAYMENTS_MODE=live  when Paystack is configured
PAYMENTS_MODE="mock"
PAYSTACK_SECRET_KEY=""
PAYSTACK_WEBHOOK_SECRET=""
FLUTTERWAVE_SECRET_KEY=""

# SMS — leave empty for mock (logs to MessageLog)
TERMII_API_KEY=""
TERMII_SENDER_ID="KMS"
