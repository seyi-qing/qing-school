# Copy to .env locally. On Vercel: Project → Settings → Environment Variables.

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"
SESSION_SECRET="change-this-to-a-long-random-string-at-least-32-chars"
SETUP_SECRET="one-time-secret-used only during controlled bootstrap"\n# Production must be false/unset. Use a one-time authenticated bootstrap instead.\nALLOW_SETUP_SEED="false"\n\n# mock is allowed during staging/development; set live only after gateway keys are configured.\nPAYMENTS_MODE="mock"

# Public site URL (used for Paystack callback). Example:
# NEXT_PUBLIC_APP_URL="https://qing-school.vercel.app"
NEXT_PUBLIC_APP_URL=""

# Payments — leave empty for mock mode
PAYSTACK_SECRET_KEY=""
PAYSTACK_WEBHOOK_SECRET=""
FLUTTERWAVE_SECRET_KEY=""

# SMS — leave empty for mock mode (still logs to MessageLog)
TERMII_API_KEY=""
TERMII_SENDER_ID="FORCESCH"
