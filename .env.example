# Copy this file to .env for local development.
# On Vercel: set these in Project → Settings → Environment Variables.

# PRODUCTION (Vercel): use a Postgres connection string from Neon, Supabase, or Vercel Postgres.
# Example Neon:
# DATABASE_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# Long random string used to sign session JWTs. Generate with:
#   openssl rand -base64 48
SESSION_SECRET="change-this-to-a-long-random-string-at-least-32-chars"

# Optional Phase-2 integrations (app works in mock mode without them)
PAYSTACK_SECRET_KEY=""
FLUTTERWAVE_SECRET_KEY=""
TERMII_API_KEY=""
TERMII_SENDER_ID="FORCESCH"
