# Copy this file to .env before running the app.

# SQLite database file (self-contained, no external DB server required).
# For production on a VPS you can swap this for a MySQL/Postgres connection
# string -- Prisma supports both; see prisma/schema.prisma "provider".
DATABASE_URL="file:./dev.db"

# Long random string used to sign session tokens (JWT). Generate one with:
#   openssl rand -base64 48
SESSION_SECRET="change-this-to-a-long-random-string"

# --- Phase 2 integration placeholders --------------------------------------
# These are read by lib/integrations/*.ts. The app runs fully in "mock mode"
# without them (payments and SMS are logged instead of actually sent), so you
# can develop and demo everything before paying for any of these accounts.

PAYSTACK_SECRET_KEY=""
FLUTTERWAVE_SECRET_KEY=""
TERMII_API_KEY=""
TERMII_SENDER_ID="FORCESCH"
