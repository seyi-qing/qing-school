{
  "name": "kms-school-erp",
  "version": "1.4.0",
  "private": true,
  "description": "Qing School — multi-tenant school ERP / SaaS (KMS first tenant)",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "setup": "npm install && prisma generate && prisma db push && npm run db:seed",
    "test": "vitest run",
    "test:unit": "tsx lib/tenant-scope.test.ts && tsx lib/permissions.test.ts && tsx lib/money.test.ts && tsx lib/rate-limit.test.ts",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "build:safe": "prisma generate && next build",
    "build:migrate": "prisma generate && prisma migrate deploy && next build",
    "build:with-push": "prisma generate && prisma db push && next build"
  },
  "dependencies": {
    "next": "14.2.15",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@prisma/client": "5.19.1",
    "prisma": "5.19.1",
    "@vercel/blob": "0.27.0",
    "@dnd-kit/core": "6.1.0",
    "@dnd-kit/sortable": "8.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "bcryptjs": "2.4.3",
    "jose": "5.9.3",
    "zod": "3.23.8",
    "date-fns": "3.6.0",
    "papaparse": "5.4.1"
  },
  "devDependencies": {
    "typescript": "5.5.4",
    "@types/node": "20.14.15",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@types/bcryptjs": "2.4.6",
    "@types/papaparse": "5.3.14",
    "tailwindcss": "3.4.10",
    "postcss": "8.4.41",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.15",
    "tsx": "4.19.0",
    "vitest": "2.1.1"
  }
}
